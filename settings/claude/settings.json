{
  "permissions": {
    "allow": [
      "Bash(find:*)"
    ]
  },
  "mcpServers": {
    "azure-devops": {
      "command": "npx",
      "args": ["-y", "@tiberriver256/mcp-server-azure-devops"],
      "env": {
        "AZURE_DEVOPS_ORG_URL": "https://dev.azure.com/moneyp",
        "AZURE_DEVOPS_DEFAULT_PROJECT": "DBSRetaguarda",
        "AZURE_DEVOPS_AUTH_METHOD": "pat",
        "AZURE_DEVOPS_PAT": "${AZURE_DEVOPS_EXT_PAT}"
      }
    }
  }
}
